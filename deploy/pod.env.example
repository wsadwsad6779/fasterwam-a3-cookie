# Copy to deploy/pod.env (gitignored) and paste the SSH command the console
# shows after the instance is running. The loop can be started before that: it
# sleeps and retries until this endpoint answers.
POD_SSH="ssh -p 45339 root@1.2.3.4"

# Optional overrides
# INTERVAL=60          # seconds between attempts
# MAX_ATTEMPTS=0       # 0 = retry forever
# E0=1                 # start the C0 baseline once the pod is ready
# E0_STEPS=600
